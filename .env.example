# Production site URL (used for RSS, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bloodsoakedmedia.com

# Recovered legacy writing on the main site (default: hidden on live site)
# Set to true only when historical articles at /articles/* are reviewed and ready
# NEXT_PUBLIC_LEGACY_ARCHIVE_PUBLIC=true

# The Archives route tree — hub, Metal Lifestyle, and nested archive features
# Local `npm run dev` enables The Archives automatically. Production omits the
# entire /the-archives section unless explicitly enabled on a staging host.
# NEXT_PUBLIC_ARCHIVES_LOCAL=true

# Curator Mode — Workbench / editorial tools (default: off in production)
# Local `npm run dev` enables the Workbench automatically.
# Set true only on explicit curator or staging environments — never on the
# public Bloodsoaked website.
# NEXT_PUBLIC_CURATOR_MODE=true

# --- Collection Instagram sync (ingestion only — local archive is canonical) ---
# Requires Instagram Professional (Business or Creator) + Meta Business app
# Permission: instagram_business_basic
# Generate token: Meta App Dashboard → Instagram → API setup with Instagram login
# INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token
# INSTAGRAM_USER_ID=your_instagram_business_account_id
# INSTAGRAM_GRAPH_API_VERSION=v25.0
# INSTAGRAM_API_BASE_URL=https://graph.instagram.com
# Ingestion: all Instagram posts are synced (no hashtag filter required)
# Development seeds use origin: "development" and are excluded from the public index.
# After Instagram validation: npm run collection:purge-development
# COLLECTION_SYNC_PAGE_LIMIT=25
# COLLECTION_SYNC_REQUEST_DELAY_MS=200
